   944                              <1> ;Return Values:
   945                              <1> ;	RAX = number of swaps done
   946                              <1> ;	RAX = 0: array is sorted, or, the number of items indicated is 0 or less than 0
   947                              <1> ;Example Usage:
   948                              <1> ;	push	theArray	;Address of the quad-word array
   949                              <1> ;	push	10h			;Number of items in the array
