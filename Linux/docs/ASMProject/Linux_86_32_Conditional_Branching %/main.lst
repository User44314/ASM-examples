    47                                  	;unsigned above (a) and below (b)
    48 00000023 B805000000              	mov eax, 5
    49 00000028 83F80A                  	cmp eax, 10
    50 0000002B 741E                    	je eaxEqualTo10     ;==
    51 0000002D 751D                    	jne eaxNotEqualTo10  ;!=
    52 0000002F 721C                    	jb eaxLessThan10   ;<
    53 00000031 771B                    	ja eaxGreaterThan10   ;>
    54 00000033 761A                    	jbe eaxLessThanEqual10 ;<=
    55 00000035 7319                    	jae eaxGreaterThanEqual10   ;>=
    56                                  	
    57                                  	;signed greater (g) and less than (1)
    58 00000037 B8FBFFFFFF              	mov eax, -5
    59 0000003C 83F80A                  	cmp eax, 10
    60 0000003F 740A                    	je eaxEqualTo10     ;==
    61 00000041 7509                    	jne eaxNotEqualTo10  ;!=
    62 00000043 7C08                    	jl eaxLessThan10   ;<
    63 00000045 7F07                    	jg eaxGreaterThan10   ;>
    64 00000047 7E06                    	jle eaxLessThanEqual10 ;<=
    65 00000049 7D05                    	jge eaxGreaterThanEqual10   ;>=
