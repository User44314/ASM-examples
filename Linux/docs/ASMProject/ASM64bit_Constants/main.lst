     1                                  MY_CONSTANT1		equ	22h
     2                                  MY_ASCII_CONSTANTS 	equ	'A'
     3                                  
     4                                  
     5                                  
     6                                  section .data
     7                                  ;variables with values go here
     8                                  
     9                                  section .bss
    10                                  ;reserved memory goes here
    11                                  section .text
    12                                  ;Your program code goes here
    13                                  	global  _start 
    14                                  	_start:
    15                                  
    16 00000000 90                      	nop	
    17                                  	;Your program code should go here
    18                                  	
    19 00000001 B822000000              	mov rax, MY_CONSTANT1
    20 00000006 B822000000              	mov eax, MY_CONSTANT1
    21 0000000B B022                    	mov al, MY_CONSTANT1
    22                                  	
    23                                  	
    24                                  
    25 0000000D 90                      	nop
    26                                  	;Do not remove/change the lines below
    27                                  	;These exit out of the application and back
    28                                  	;to linux in an orderly fashion
    29 0000000E B83C000000              	mov		rax, 60					;60 = system exit
    30 00000013 BF00000000              	mov		rdi, 0					;0 = return code
    31 00000018 0F05                    	syscall							;Poke the kernel
